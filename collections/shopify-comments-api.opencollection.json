          "http": {
            "method": "POST",
            "url": "https://{store}.myshopify.com/admin/api/2025-01/admin/api/2020-01/comments/:comment_id/approve.json",
            "params": [
              {
                "name": "comment_id",
                "value": "",
                "type": "path",
