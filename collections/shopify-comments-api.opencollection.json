              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "https://shopify.dev/docs/admin-api/rest/reference/online-store/comment#approve-2020-01"
        },
        {
          "info": {
            "name": "Shopify Removes A Comment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{store}.myshopify.com/admin/api/2025-01/admin/api/2020-01/comments/:comment_id/remove.json",
            "params": [
              {
                "name": "comment_id",
