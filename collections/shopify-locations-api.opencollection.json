{
  "opencollection": "1.0.0",
  "info": {
    "name": "Shopify Admin REST About Locations API",
    "version": "2025-01"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Shopify-Access-Token",
      "value": "{{X-Shopify-Access-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Locations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Shopify Retrieve a list of locations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{store}.myshopify.com/admin/api/2025-01/locations.json"
          },
          "docs": "Retrieves a list of all locations for a shop."
        },
        {
          "info": {
            "name": "Shopify Retrieve a count of locations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{store}.myshopify.com/admin/api/2025-01/locations/count.json"
          },
          "docs": "Retrieves a count of locations for a shop."
        },
        {
          "info": {
            "name": "Shopify Retrieve a single location",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{store}.myshopify.com/admin/api/2025-01/locations/:location_id.json",
            "params": [
              {
                "name": "location_id",
                "value": "",
                "type": "path",
                "description": "The ID of the location"
              }
            ]
          },
          "docs": "Retrieves a single location by ID."
        }
      ]
    }
  ],
  "bundled": true
}