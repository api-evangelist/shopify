{
  "opencollection": "1.0.0",
  "info": {
    "name": "Shopify Admin REST About Scopes API",
    "version": "2025-01"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Shopify-Access-Token",
      "value": "{{X-Shopify-Access-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Scopes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Shopify Retrieves A List Of Access Scopes Associated To The Access Token",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{store}.myshopify.com/admin/api/2025-01/admin/oauth/access_scopes.json"
          },
          "docs": "https://shopify.dev/docs/admin-api/rest/reference/access/accessscope#index-2020-10"
        }
      ]
    }
  ],
  "bundled": true
}