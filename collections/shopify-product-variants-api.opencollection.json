{
  "opencollection": "1.0.0",
  "info": {
    "name": "Shopify Admin REST About Product Variants API",
    "version": "2025-01"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Shopify-Access-Token",
      "value": "{{X-Shopify-Access-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Product Variants",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Shopify Retrieve a list of product variants",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{store}.myshopify.com/admin/api/2025-01/products/:product_id/variants.json",
            "params": [
              {
                "name": "product_id",
                "value": "",
                "type": "path",
                "description": "The ID of the product"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of results (max 250, default 50)"
              },
              {
                "name": "since_id",
                "value": "",
                "type": "query",
                "description": "Return variants after the specified ID"
              },
              {
                "name": "fields",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of fields to include"
              }
            ]
          },
          "docs": "Retrieves all variants for a given product."
        },
        {
          "info": {
            "name": "Shopify Create a product variant",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{store}.myshopify.com/admin/api/2025-01/products/:product_id/variants.json",
            "params": [
              {
                "name": "product_id",
                "value": "",
                "type": "path",
                "description": "The ID of the product"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new variant for a product."
        }
      ]
    }
  ],
  "bundled": true
}